# ==============================================================================
# vellum — Переменные окружения для локальной разработки
# Скопируйте этот файл в .env.local: cp .env.example .env.local
# ==============================================================================

# Core App Settings
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:dev_password@localhost:5432/vellum_db?schema=public"

# Redis Cache & Background Queue
REDIS_URL="redis://localhost:6379"

# Authentication & Security
AUTH_SECRET="change-this-to-a-secure-random-32-byte-secret"

# Third-party Integrations
# OPENAI_API_KEY="sk-..."
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# NEXT_PUBLIC_POSTHOG_KEY="phc_..."
